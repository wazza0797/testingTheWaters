# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit real secrets. See docs/architecture.md for the full reference.

# --- Mode -------------------------------------------------------------------
# "paper" (default) — local FillSimulator, no order API
# "demo"  — venue practice account (IG demo by default; see TP_OVERLAY)
# "live"  — real money (Milestone 8b, double-gated; not for casual use)
# "backtest" — historical simulation
ENV=paper

# --- Exchange secrets -------------------------------------------------------
# Default production sleeve is IG demo (TP_OVERLAY=ig-us500).
# Demo host is demo-api.ig.com; live is api.ig.com — credentials are not
# interchangeable. Live trading is scaffolded but refused by the factory until
# Milestone 8b.
IG_DEMO_API_KEY=
IG_DEMO_USERNAME=
IG_DEMO_PASSWORD=
IG_DEMO_ACCOUNT_ID=
IG_API_KEY=
IG_USERNAME=
IG_PASSWORD=
IG_ACCOUNT_ID=

# --- Live trading double-gate (Milestone 8) ---------------------------------
# Must be explicitly "true" AND ENV=live for any real order to be placed.
LIVE_TRADING_ENABLED=false

# --- Notifications (optional, Milestone 7) ----------------------------------
# Console always gets fills / risk+order rejects / errors / heartbeats.
# Discord: one webhook per run mode (no cross-posting). Create a webhook in
# each Discord channel (Settings → Integrations → Incoming Webhook).
#   ENV=paper|backtest  → DISCORD_WEBHOOK_URL
#   ENV=demo            → DISCORD_DEMO_WEBHOOK_URL
#   ENV=live            → DISCORD_LIVE_WEBHOOK_URL
# Telegram: BotFather token + chat id (both required; shared across modes).
DISCORD_WEBHOOK_URL=
DISCORD_DEMO_WEBHOOK_URL=
DISCORD_LIVE_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Logging ------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=text

# --- Observability --------------------------------------------------------
METRICS_PORT=9090
HEALTH_PORT=8080
OBSERVABILITY_ENABLED=true

# --- Storage ----------------------------------------------------------------
DATA_DIR=data

# --- Docker / Milestone 9 ---------------------------------------------------
# Used by docker-compose.yml (host-side interpolation). Overlay selects the
# trading sleeve when the container runs `trading-platform demo --overlay …`.
TP_OVERLAY=ig-us500
# Prometheus UI on the host (app /metrics stays on container :9090 only).
# PROMETHEUS_PORT=9091
# GRAFANA_PORT=3000
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
