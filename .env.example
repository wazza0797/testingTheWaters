# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit real secrets. See docs/architecture.md for the full reference.

# --- Mode -------------------------------------------------------------------
# "paper" (default) — local FillSimulator, no order API
# "demo"  — exchange sandbox/practice (Binance Demo, later Trading 212, …)
# "live"  — real money (Milestone 8b, double-gated; not for casual use)
# "backtest" — historical simulation
ENV=paper

# --- Exchange secrets -------------------------------------------------------
# Paper/backtest: optional (public OHLCV).
# Demo: BINANCE_DEMO_* from demo.binance.com (never put live keys here).
# Live: BINANCE_API_* + LIVE_TRADING_ENABLED (Milestone 8b).
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=

# --- Live trading double-gate (Milestone 8) ---------------------------------
# Must be explicitly "true" AND ENV=live for any real order to be placed.
LIVE_TRADING_ENABLED=false

# --- Notifications (optional, Milestone 7) ----------------------------------
# Console always gets fills / risk+order rejects / errors / heartbeats.
# Set either (or both) remote channels to fan out the same events:
#   - Discord: channel Settings → Integrations → Incoming Webhook → copy URL
#   - Telegram: BotFather token + your chat id (both required)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Logging ------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=text

# --- Observability --------------------------------------------------------
METRICS_PORT=9090
HEALTH_PORT=8080
OBSERVABILITY_ENABLED=true

# --- Storage ----------------------------------------------------------------
DATA_DIR=data
