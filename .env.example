# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit real secrets. See docs/architecture.md for the full reference.

# --- Mode -------------------------------------------------------------------
# "paper" (default, safe, no keys required) or "live" (Milestone 8, gated).
ENV=paper

# --- Exchange secrets (optional for paper mode, required for live) ---------
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Live trading double-gate (Milestone 8) ---------------------------------
# Must be explicitly "true" AND ENV=live for any real order to be placed.
LIVE_TRADING_ENABLED=false

# --- Notifications (optional, Milestone 7) ----------------------------------
# When both are set, paper fills / risk rejects / errors / heartbeats also
# fan out to Telegram. Missing either → console only (warning logged).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Logging ------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=text

# --- Observability --------------------------------------------------------
METRICS_PORT=9090
HEALTH_PORT=8080
OBSERVABILITY_ENABLED=true

# --- Storage ----------------------------------------------------------------
DATA_DIR=data
